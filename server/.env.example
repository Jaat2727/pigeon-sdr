# ===========================================================================
# Backend environment (Node / Express)
#
# Copy to `server/.env` for local development. On Railway, set these in
# Service -> Variables.
# ===========================================================================

# ── Required ───────────────────────────────────────────────────────────────
# Supabase project URL and SERVICE ROLE key. The service role key bypasses row
# level security and must never appear in frontend code or in the repository.
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API, comma separated, no trailing
# slashes. Add your Vercel production URL here or every request is blocked by
# CORS. Any *.vercel.app preview is allowed automatically once one vercel.app
# origin is listed.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── DronaHQ agents ─────────────────────────────────────────────────────────
# One webhook URL per agent. An agent with no URL (or no key) runs on the
# built-in local engine instead, and every run records which engine served it.
#
# A single key for every agent:
DRONAHQ_API_KEY=

# Per-agent URLs. Copy each from the agent's Webhook trigger in DronaHQ.
DRONAHQ_RESEARCH_URL=
DRONAHQ_ICP_URL=
DRONAHQ_STRATEGY_URL=
DRONAHQ_PERSONALISATION_URL=
DRONAHQ_CONVERSATION_URL=

# Per-agent keys, only if an agent uses a different key from DRONAHQ_API_KEY.
DRONAHQ_RESEARCH_KEY=
DRONAHQ_ICP_KEY=
DRONAHQ_STRATEGY_KEY=
DRONAHQ_PERSONALISATION_KEY=
DRONAHQ_CONVERSATION_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Background worker. Off by default: during a demo you drive the pipeline from
# the UI instead, so it does not spend model budget between takes.
WORKER_ENABLED=false
WORKER_POLL_MS=30000
WORKER_BATCH_SIZE=5

# Spend and latency guardrails.
MAX_AGENT_CALLS_PER_DAY=200
AGENT_TIMEOUT_MS=45000
COST_PER_1K_TOKENS_USD=0.015

# Set false to make a failed DronaHQ call an error instead of falling back to
# the local engine. Leave it true unless you specifically want the pipeline to
# stop when an agent is misconfigured.
LOCAL_ENGINE_ENABLED=true
