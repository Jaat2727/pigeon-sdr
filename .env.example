# ===========================================================================
# Frontend environment (Vite)
#
# Copy to `.env` for local development. On Vercel, set the same keys in
# Project Settings -> Environment Variables.
#
# Vite inlines VITE_* values at BUILD time. Changing one on Vercel does
# nothing until you redeploy.
# ===========================================================================

# Required. The Railway URL of the API, with no trailing slash.
VITE_API_BASE_URL=https://your-api.up.railway.app

# Optional. Set both to require a real sign-in. Leave them blank and the app
# opens directly in open-access mode, which is what you want for a judged demo
# link. The anon key is the only Supabase key that may reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
